{
  "title": "OptiFlow - System Health Overview",
  "uid": "system-health-overview",
  "tags": ["optiflow", "health", "monitoring", "overview"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "🟢 System Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(up{job=~\"optiflow.*|postgres|redis|influxdb\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "range", "options": {"from": 8, "to": 10, "result": {"text": "HEALTHY", "color": "green"}}},
            {"type": "range", "options": {"from": 5, "to": 7, "result": {"text": "DEGRADED", "color": "yellow"}}},
            {"type": "range", "options": {"from": 0, "to": 4, "result": {"text": "CRITICAL", "color": "red"}}}
          ],
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 5, "color": "yellow"},
              {"value": 8, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Services Up",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [
        {
          "expr": "sum(up{job=~\"optiflow.*|postgres|redis|influxdb\"})",
          "legendFormat": "Up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 5, "color": "yellow"},
              {"value": 8, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 3, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Host Memory",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 85, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Host CPU",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 85, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Disk Usage",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 85, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Service Status Grid",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "up",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "instance": false},
            "renameByName": {
              "job": "Service",
              "instance": "Instance",
              "Value": "Status"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"type": "value", "options": {"1": {"text": "✅ UP", "color": "green"}}},
                  {"type": "value", "options": {"0": {"text": "❌ DOWN", "color": "red"}}}
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Container Memory Usage",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"optiflow.*\"} / 1024 / 1024",
          "legendFormat": "{{ name }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 500, "color": "yellow"},
              {"value": 1000, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 9,
      "title": "Memory Trend (Predict Next Hour)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"optiflow.*\"} / 1024 / 1024",
          "legendFormat": "{{ name }} - Current",
          "refId": "A"
        },
        {
          "expr": "predict_linear(container_memory_usage_bytes{name=~\"optiflow.*\"}[30m], 3600) / 1024 / 1024",
          "legendFormat": "{{ name }} - Predicted (1h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes"
        }
      }
    },
    {
      "id": 10,
      "title": "API Response Time (P95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"optiflow-backend\"}[5m]))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"optiflow-backend\"}[5m]))",
          "legendFormat": "P50 Latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.5, "color": "yellow"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Database Connections",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"optiflow\"}",
          "legendFormat": "Active Connections",
          "refId": "A"
        },
        {
          "expr": "pg_settings_max_connections",
          "legendFormat": "Max Connections",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 12,
      "title": "Redis Memory",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 20},
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "Used Memory",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes / 1024 / 1024",
          "legendFormat": "Max Memory",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes"
        }
      }
    },
    {
      "id": 13,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 20},
      "targets": [
        {
          "expr": "kafka_consumer_group_lag",
          "legendFormat": "{{ consumer_group }} - {{ topic }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1000, "color": "yellow"},
              {"value": 10000, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Gateway Health",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 26},
      "targets": [
        {
          "expr": "gateway_devices_connected{protocol=\"opc_ua\"}",
          "legendFormat": "OPC-UA Devices",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "title": "Gateway Buffer",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 26},
      "targets": [
        {
          "expr": "gateway_buffer_size",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 5000, "color": "yellow"},
              {"value": 8000, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 16,
      "title": "Tags Read Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 26},
      "targets": [
        {
          "expr": "rate(gateway_tags_read_total[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 17,
      "title": "Data Points/sec",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 26},
      "targets": [
        {
          "expr": "rate(gateway_data_points_collected_total[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 18,
      "title": "Active Alerts",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 30},
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "alertstate": true},
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "description": "Description"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Severity"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"type": "value", "options": {"critical": {"text": "🔴 CRITICAL", "color": "red"}}},
                  {"type": "value", "options": {"warning": {"text": "🟡 WARNING", "color": "yellow"}}},
                  {"type": "value", "options": {"info": {"text": "🔵 INFO", "color": "blue"}}}
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
