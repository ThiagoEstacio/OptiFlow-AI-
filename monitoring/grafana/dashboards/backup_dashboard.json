{
  "title": "OptiFlow Backup & DR",
  "uid": "optiflow-backup",
  "tags": ["backup", "disaster-recovery", "optiflow"],
  "timezone": "utc",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Backup Status Overview",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "optiflow_backup_success_total",
          "legendFormat": "Successful Backups",
          "refId": "A"
        },
        {
          "expr": "optiflow_backup_failed_total",
          "legendFormat": "Failed Backups",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Last Backup Time",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "time() - optiflow_backup_last_success_timestamp",
          "legendFormat": "Hours Since Last Backup",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 86400, "color": "yellow"},
              {"value": 172800, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Backup Duration by Service",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "optiflow_backup_duration_seconds{service=~\".*\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "s",
          "label": "Duration"
        },
        {"format": "short"}
      ]
    },
    {
      "id": 4,
      "title": "Backup Size by Service",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "optiflow_backup_size_bytes{service=~\".*\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "bytes",
          "label": "Size"
        },
        {"format": "short"}
      ]
    },
    {
      "id": 5,
      "title": "Backup Success Rate (7 days)",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "(sum(increase(optiflow_backup_success_total[7d])) / sum(increase(optiflow_backup_total[7d]))) * 100",
          "legendFormat": "Success Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 95, "color": "yellow"},
              {"value": 99, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Backup Disk Usage",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
        {
          "expr": "optiflow_backup_disk_used_bytes",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "optiflow_backup_disk_free_bytes",
          "legendFormat": "Free",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 85, "color": "yellow"},
              {"value": 95, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Backup Timeline",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "optiflow_backup_last_success_timestamp * 1000",
          "format": "table",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "service": 0,
              "Value": 1
            },
            "renameByName": {
              "service": "Service",
              "Value": "Last Backup"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Retention Policy Status",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "time() - optiflow_backup_last_cleanup_timestamp",
          "legendFormat": "Days Since Last Cleanup",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 604800, "color": "yellow"},
              {"value": 1209600, "color": "red"}
            ]
          }
        }
      }
    }
  ]
}
