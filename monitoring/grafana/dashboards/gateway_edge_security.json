          "expr": "gateway_opcua_sessions_active",
          "legendFormat": "OPC-UA Sessions",
          "refId": "B"
        }
      ],
      "title": "OPC-UA Protocol Stats",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
