  "description": "Gateway Edge Microservice - Security & Performance Dashboard",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"type": "value", "options": {"1": {"text": "Healthy", "color": "green"}}},
            {"type": "value", "options": {"0": {"text": "Unhealthy", "color": "red"}}}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "up{job=\"optiflow-gateway\"}",
          "legendFormat": "Gateway Status",
          "refId": "A"
        }
      ],
      "title": "Gateway Health",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "gateway_devices_connected",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ],
      "title": "Connected Devices",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "gateway_tags_total",
          "legendFormat": "Total Tags",
          "refId": "A"
        }
      ],
      "title": "Total Tags Configured",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "gateway_buffer_size / gateway_buffer_capacity",
          "legendFormat": "Buffer Usage",
          "refId": "A"
        }
      ],
      "title": "Buffer Usage %",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineWidth": 2
          },
          "unit": "ops"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "rate(gateway_tags_read_total[1m])",
          "legendFormat": "Tags Read/s",
          "refId": "A"
        },
        {
          "expr": "rate(gateway_tag_value_changes_total[1m])",
          "legendFormat": "Value Changes/s",
          "refId": "B"
        }
      ],
      "title": "Tag Read Operations",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(gateway_tags_read_duration_seconds_bucket[5m]))",
          "legendFormat": "p50 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(gateway_tags_read_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(gateway_tags_read_duration_seconds_bucket[5m]))",
          "legendFormat": "p99 Latency",
          "refId": "C"
        }
      ],
      "title": "Tag Read Latency Distribution",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
