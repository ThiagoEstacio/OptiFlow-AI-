        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 12},
      "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "rate(gateway_modbus_requests_total[1m])",
