# Production Environment Variables
# Copy this file to .env.prod and fill in your production values
# NEVER commit .env.prod to version control!

# ================================
# APPLICATION
# ================================
APP_NAME="SmartPort Production"
ENVIRONMENT=production
DEBUG=false

# ================================
# SECURITY
# ================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Gateway API Key
# Generate with: openssl rand -hex 32
GATEWAY_API_KEY=your-gateway-api-key-change-this-in-production

# ================================
# DATABASE - POSTGRESQL
# ================================
POSTGRES_DB=smartport_prod
POSTGRES_USER=smartport_prod
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your-strong-postgres-password-here

# ================================
# DATABASE - INFLUXDB
# ================================
INFLUX_USER=admin
# Generate with: openssl rand -base64 32
INFLUX_PASSWORD=your-strong-influx-password-here
INFLUX_ORG=smartport
INFLUX_BUCKET=timeseries
# Generate with: openssl rand -hex 32
INFLUX_TOKEN=your-influxdb-admin-token-here

# ================================
# DATABASE - REDIS
# ================================
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=your-strong-redis-password-here

# ================================
# CORS CONFIGURATION
# ================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# ================================
# FRONTEND
# ================================
VITE_API_URL=https://api.yourdomain.com

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=7

# ================================
# EMAIL (Optional - for notifications)
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@yourdomain.com

# ================================
# MONITORING (Optional)
# ================================
SENTRY_DSN=https://your-sentry-dsn-here
SENTRY_ENVIRONMENT=production

# ================================
# SSL CERTIFICATE (Let's Encrypt)
# ================================
# Your domain name for SSL certificate
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
