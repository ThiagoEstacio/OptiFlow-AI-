# Application
APP_NAME=OptiFlow AI Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-strong-random-key
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://optiflow:optiflow_password@postgres:5432/optiflow
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Database - InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-secret-influxdb-token
INFLUXDB_ORG=optiflow
INFLUXDB_BUCKET=timeseries
INFLUXDB_BUCKET_AGGREGATIONS=aggregations
INFLUXDB_BUCKET_DOWNSAMPLED=downsampled

# Database - Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_REALTIME_DB=3

# Message Queue - RabbitMQ
RABBITMQ_URL=amqp://optiflow:optiflow_password@rabbitmq:5672/
CELERY_BROKER_URL=amqp://optiflow:optiflow_password@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/4

# Security
JWT_SECRET_KEY=change-me-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# WebSocket
WEBSOCKET_PING_INTERVAL=25
WEBSOCKET_PING_TIMEOUT=60

# ML / MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=optiflow-ml
ML_MODEL_REGISTRY=models

# Gateway
GATEWAY_API_KEY=secure-gateway-api-key-change-in-production

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# File Upload
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@optiflow.ai

# SMS (for critical alarms)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Data Retention
TIMESERIES_RETENTION_DAYS=365
AGGREGATIONS_RETENTION_DAYS=1825
DOWNSAMPLED_RETENTION_DAYS=3650
ALARM_HISTORY_RETENTION_DAYS=730
