# SmartPort Staging Environment Configuration
# This file contains staging-specific settings for testing before production

# ===================================
# ENVIRONMENT
# ===================================
ENVIRONMENT=staging
DEBUG=false

# ===================================
# DATABASE - PostgreSQL
# ===================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=smartport_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD_HERE
POSTGRES_DB=smartport_staging

# Connection pool settings (staging - moderate)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===================================
# INFLUXDB - Time Series Database
# ===================================
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=CHANGE_ME_STAGING_INFLUXDB_TOKEN_HERE
INFLUXDB_ORG=smartport-staging
INFLUXDB_BUCKET=smartport-staging

# InfluxDB Admin Setup (first run only)
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME_STAGING_INFLUXDB_ADMIN_PASSWORD
DOCKER_INFLUXDB_INIT_ORG=smartport-staging
DOCKER_INFLUXDB_INIT_BUCKET=smartport-staging
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_STAGING_INFLUXDB_TOKEN_HERE

# ===================================
# REDIS - Cache
# ===================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD_HERE
REDIS_DB=0

# ===================================
# AUTHENTICATION
# ===================================
# Generate secure secret: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_STAGING_SECRET_KEY_MINIMUM_32_CHARACTERS_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===================================
# SECURITY
# ===================================
# CORS Origins (staging domains)
CORS_ORIGINS=["https://staging.yourdomain.com","https://staging-api.yourdomain.com"]

# Rate Limiting (staging - more lenient than production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# ===================================
# BACKEND API
# ===================================
API_V1_PREFIX=/api/v1
PROJECT_NAME=SmartPort-Staging

# ===================================
# GATEWAY CONFIGURATION
# ===================================
GATEWAY_LOG_LEVEL=INFO
GATEWAY_POLL_INTERVAL=5
GATEWAY_MAX_RETRIES=3
GATEWAY_TIMEOUT=10

# Protocol-specific settings
OPCUA_TIMEOUT=30
MODBUS_TIMEOUT=10
MQTT_KEEPALIVE=60

# ===================================
# MONITORING
# ===================================
# Prometheus
PROMETHEUS_RETENTION_TIME=30d

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STAGING_GRAFANA_PASSWORD_HERE
GF_SERVER_ROOT_URL=https://staging-grafana.yourdomain.com
GF_INSTALL_PLUGINS=

# Alertmanager
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK
ALERTMANAGER_EMAIL_TO=staging-alerts@yourdomain.com
ALERTMANAGER_EMAIL_FROM=smartport-staging@yourdomain.com

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===================================
# BACKUP
# ===================================
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=smartport-staging-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ===================================
# FRONTEND
# ===================================
NEXT_PUBLIC_API_URL=https://staging-api.yourdomain.com
NEXT_PUBLIC_ENVIRONMENT=staging

# ===================================
# SSL/TLS (Let's Encrypt Staging)
# ===================================
LETSENCRYPT_EMAIL=admin@yourdomain.com
LETSENCRYPT_STAGING=true

# ===================================
# TESTING
# ===================================
# Enable test endpoints in staging
ENABLE_TEST_ENDPOINTS=true

# Test data seeding
SEED_TEST_DATA=true
