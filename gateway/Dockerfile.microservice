# ============================================================================
# OptiFlow Gateway - Microservice Dockerfile
# ============================================================================
#
# Multi-stage build optimized for:
# - Small image size (~200MB)
# - Fast startup (< 5s)
# - Security (non-root user)
# - Production-ready (health checks, graceful shutdown)
#
# Build:
#   docker build -f Dockerfile.microservice -t optiflow-gateway:edge .
#
# Run (Development):
#   docker run -p 8080:8080 optiflow-gateway:edge
#
# Run (Production with Gunicorn):
#   docker run -p 8080:8080 -e MODE=production optiflow-gateway:edge
# ============================================================================

# === STAGE 1: Builder ===
FROM python:3.11-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY gateway/requirements.txt .

# Install Python dependencies to /install directory
RUN pip install --no-cache-dir --prefix=/install \
    -r requirements.txt \
    gunicorn \
    uvicorn[standard]


# === STAGE 2: Runtime ===
FROM python:3.11-slim

LABEL maintainer="OptiFlow Team"
LABEL description="OptiFlow Gateway Edge - Microservice for Industrial IoT"
LABEL version="2.0.0-edge"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r gateway && \
    useradd -r -g gateway -u 1000 gateway && \
    mkdir -p /app /app/data /app/logs && \
    chown -R gateway:gateway /app

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY --chown=gateway:gateway gateway/app ./app
COPY --chown=gateway:gateway gateway/config ./config

# Create required directories
RUN mkdir -p /app/data/buffer /app/logs && \
    chown -R gateway:gateway /app/data /app/logs

# Switch to non-root user
USER gateway

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    MODE=development \
    HOST=0.0.0.0 \
    PORT=8080 \
    WORKERS=4 \
    GATEWAY_ID=gateway-001 \
    GATEWAY_NAME="OptiFlow Gateway Edge" \
    LOG_LEVEL=INFO

# Expose ports
EXPOSE 8080

# Health check (Kubernetes liveness/readiness probe)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# Entrypoint script
COPY --chown=gateway:gateway gateway/docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Default command (can be overridden)
# Development: uvicorn with reload
# Production: gunicorn with uvicorn workers
CMD ["uvicorn", "app.main_hybrid:app", "--host", "0.0.0.0", "--port", "8080"]
