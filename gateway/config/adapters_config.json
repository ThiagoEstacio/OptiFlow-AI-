      "opcua-siemens-utilities": "PLC Siemens S7-1200 para utilidades (compressores, caldeiras, geradores)",
      "modbus-schneider-energy": "Medidores Schneider PM5560/PM5350 para monitoramento de energia",
      "ethernetip-rockwell-shiploader": "PLC Rockwell ControlLogix para shiploaders e trippers",
      "mqtt-iot-sensors": "Sensores IoT ESP32/Raspberry Pi para monitoramento ambiental",
      "mqtt-process-sensors": "Sensores de processo via gateway IoT"
    }
