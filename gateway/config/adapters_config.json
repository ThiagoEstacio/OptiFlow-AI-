  "_metadata": {
    "version": "5.0",
    "description": "OptiFlow Gateway - Adapters Multi-Protocolo para PLCs Industriais Reais",
    "updated_at": "2025-12-04",
    "architecture_note": "Ver docs/PREMISSAS_ARQUITETURA.md para regras de implementação",
    "protocols_supported": {
      "opcua": {
        "description": "OPC Unified Architecture - Padrão IEC 62541",
        "adapters": ["opcua-siemens-teag", "opcua-schneider-eletrocentro", "opcua-rockwell-packaging", "opcua-siemens-utilities"],
        "simulation": "Node-RED node-red-contrib-opcua server na porta 4840"
      },
      "modbus": {
        "description": "Modbus TCP/IP - Protocolo para medidores e inversores",
        "adapters": ["modbus-schneider-energy"],
        "simulation": "Node-RED node-red-contrib-modbus server na porta 502"
      },
      "ethernetip": {
        "description": "EtherNet/IP CIP - Protocolo Rockwell/ODVA",
        "adapters": ["ethernetip-rockwell-shiploader"],
        "simulation": "Node-RED node-red-contrib-cip-ethernet-ip na porta 44818"
      },
      "mqtt": {
        "description": "MQTT 3.1.1 - IoT e sensores wireless",
        "adapters": ["mqtt-iot-sensors", "mqtt-process-sensors"],
        "simulation": "RabbitMQ MQTT plugin na porta 1883"
      }
    },
    "production_mapping": {
      "opcua-siemens-teag": "PLC Siemens S7-1500 para controle do terminal de grãos TEAG",
      "opcua-schneider-eletrocentro": "PLC Schneider M340 para automação do eletrocentro (transformadores, CCMs, banco de capacitores)",
