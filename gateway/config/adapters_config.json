      "opcua", "modbus", "mqtt",
      "virtual_opcua", "virtual_modbus", "virtual_profinet", "virtual_ethernetip"
    ],
    "notes": {
      "siemens": "Siemens S7-1200/1500 expõem OPC-UA nativamente na porta 4840",
      "rockwell": "Rockwell via FactoryTalk Gateway OPC-UA ou KEPServerEX",
      "modbus": "Medidores de energia, inversores, CLPs genéricos",
      "mqtt": "Sensores IoT (ESP32, Raspberry Pi), gateways LoRaWAN",
      "virtual": "Adaptadores virtuais que leem do buffer Node-RED para simulação"
    },
