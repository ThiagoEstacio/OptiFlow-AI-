      "description": "Virtual adapters read from Node-RED ingestion buffer",
      "source": "Node-RED Grain Terminal Simulator",
      "protocols": {
        "virtual_opcua": "Gates control (ARZ_GATES_*) - Siemens S7 simulation",
        "virtual_modbus": "Conveyor belts (CORR*) - VFD/Motor controller simulation",
        "virtual_profinet": "Bucket elevator (ELV*) - PROFINET IO simulation",
        "virtual_ethernetip": "Shiploader (SLD*) - Allen-Bradley CIP simulation"
      }
