{
  "adapters": [
    {
      "adapter_id": "opcua-simulator-001",
      "adapter_name": "OptiFlow Terminal Simulator",
      "protocol_type": "opcua",
      "enabled": true,
      "host": "opcua-server",
      "port": 4840,
      "scan_rate_ms": 1000,
      "timeout": 10.0,
      "retry_interval": 10.0,
      "extra_config": {
        "security_mode": "None",
        "security_policy": "None",
        "subscription_interval": 100
      },
      "tags": [],
      "kafka_config": {
        "topic": "raw_tags",
        "bootstrap_servers": "kafka-1:9092,kafka-2:9093,kafka-3:9096",
        "producer_config": {
          "acks": "1",
          "compression_type": "lz4",
          "linger_ms": 100,
          "batch_size": 16384
        }
      }
    }
  ]
}
