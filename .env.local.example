# OptiFlow AI - Local Configuration
# Copy this file to .env.local and customize as needed

# ==============================================================================
# SERVICE ENABLEMENT
# ==============================================================================

# Enable/disable backend services (PostgreSQL, InfluxDB, Redis via Docker)
ENABLE_BACKEND=true

# Enable/disable SmartPort Bulk Terminal Simulator
# Set to false if you want to test only with frontend mock data
ENABLE_SIMULATOR=true

# Enable/disable frontend auto-start
ENABLE_FRONTEND=true

# ==============================================================================
# SIMULATOR CONFIGURATION
# ==============================================================================

# Modbus TCP port for simulator
SIMULATOR_MODBUS_PORT=5020

# Simulator update interval (seconds)
SIMULATOR_UPDATE_INTERVAL=2

# Enable anomaly simulation
SIMULATOR_ENABLE_ANOMALIES=true

# ==============================================================================
# BACKEND CONFIGURATION
# ==============================================================================

# Backend API URL
BACKEND_URL=http://localhost:8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=optiflow
POSTGRES_USER=optiflow
POSTGRES_PASSWORD=optiflow_password

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influx-token
INFLUXDB_ORG=optiflow
INFLUXDB_BUCKET=optiflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# API endpoint
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ==============================================================================
# DEVELOPMENT OPTIONS
# ==============================================================================

# Auto-reload on code changes
DEV_AUTO_RELOAD=true

# Debug mode
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
