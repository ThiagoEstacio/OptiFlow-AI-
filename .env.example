# OptiFlow AI Platform - Environment Variables
# Copy this file to .env and update with your values

# Application
APP_NAME="OptiFlow AI Platform"
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-string
LOG_LEVEL=INFO

# Database - PostgreSQL
POSTGRES_DB=optiflow
POSTGRES_USER=optiflow
POSTGRES_PASSWORD=change-this-secure-password
DATABASE_URL=postgresql+asyncpg://optiflow:change-this-secure-password@postgres:5432/optiflow

# Database - InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=change-this-to-secure-token
INFLUXDB_ORG=optiflow
INFLUXDB_BUCKET=timeseries
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-this-admin-password

# Database - Redis
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@redis:6379/0

# Message Queue - RabbitMQ
RABBITMQ_USER=optiflow
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_URL=amqp://optiflow:change-this-rabbitmq-password@rabbitmq:5672/
CELERY_BROKER_URL=amqp://optiflow:change-this-rabbitmq-password@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://:change-this-redis-password@redis:6379/4

# Security
JWT_SECRET_KEY=change-this-jwt-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET","POST","PUT","DELETE","PATCH"]
CORS_HEADERS=["*"]

# Gateway
GATEWAY_API_KEY=change-this-gateway-api-key

# Frontend
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com

# Monitoring - Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@yourdomain.com

# Cloud Storage (Optional - for backups)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
S3_BUCKET_NAME=optiflow-backups

# Sentry (Optional - for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
