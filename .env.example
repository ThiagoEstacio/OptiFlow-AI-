# OptiFlow AI Platform - Environment Variables
# ===============================================
# Copy this file to .env and customize the values

# ========================================
# Application Settings
# ========================================
APP_NAME="OptiFlow AI Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="production"  # development, staging, production
DEBUG=false
SECRET_KEY="your-secret-key-here-change-in-production"

# ========================================
# Gateway Service Configuration
# ========================================
GATEWAY_ENABLED=true
GATEWAY_POLL_INTERVAL_S=1.0
GATEWAY_SOURCE_NAME="optiflow-gateway"
GATEWAY_MAX_BUFFER_SIZE=10000
GATEWAY_CIRCUIT_BREAKER_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER_TIMEOUT_S=30
GATEWAY_MAX_RETRY_ATTEMPTS=3
GATEWAY_RETRY_BACKOFF_FACTOR=2.0
# GATEWAY_RATE_LIMIT_MSGS_PER_SEC=1000  # Optional rate limit
GATEWAY_TAG_DISCOVERY_INTERVAL_S=60
GATEWAY_BUFFER_FLUSH_INTERVAL_S=5

# ========================================
# Consumer Service Configuration
# ========================================
CONSUMER_ENABLED=true
CONSUMER_TOPIC="raw_tags"
CONSUMER_GROUP_ID="timeseries-writers"
CONSUMER_MIN_BATCH_SIZE=50
CONSUMER_MAX_BATCH_SIZE=500
CONSUMER_BATCH_TIMEOUT_S=5.0
CONSUMER_DEDUP_CACHE_SIZE=10000

# ========================================
# Kafka Configuration
# ========================================
KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
KAFKA_DLQ_TOPIC="raw_tags_dlq"

# ========================================
# InfluxDB Configuration
# ========================================
INFLUXDB_URL="http://influxdb:8086"
INFLUXDB_TOKEN="your-influxdb-token-here"
INFLUXDB_ORG="optiflow"
INFLUXDB_BUCKET="timeseries"

# ========================================
# OpenAI Configuration
# ========================================
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7
